{
  "name": "architct",
  "version": "0.1.0",
  "description": ":\\ARCHITECT\\ (Architect) — Infinitum's autonomous AI execution engine",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve"
  },
  "keywords": [
    "ai-agent",
    "browser-automation",
    "playwright",
    "claude",
    "infinitum"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "types": "dist/index.d.ts",
  "bin": {
    "architct": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "podium",
    "README.md"
  ]
}
